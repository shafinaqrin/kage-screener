# Cache TTL for a crawl, in seconds. 1800 = 30 minutes. The upstream site asks
# for a 20-second crawl-delay in robots.txt; a long TTL keeps us far inside it.
KAGE_SCREENER_TTL=1800

# Upstream read timeout, in seconds. The results fragment is ~2.3 MB.
KAGE_SCREENER_TIMEOUT=45

# Host port for the service (the backend talks to it over kage-network).
SCREENER_PUBLISH_PORT=19000

LOG_LEVEL=INFO
